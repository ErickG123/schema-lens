# ==============================================================================
# SchemaLens .gitignore
# ==============================================================================

# --- Segredos e Arquivos de Ambiente ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cer

# --- Rust & Cargo ---
/target/
**/target/
!tests/sqlserver/target/
**/*.rs.bk
# Para aplicações de usuário final (executáveis/Tauri), o Cargo.lock pode ser mantido ou ignorado.
# Descomente a linha abaixo caso queira ignorar builds fixados:
# Cargo.lock

# --- Node, NPM e Frontend Angular ---
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.angular/
**/.angular/

# Builds de frontend (preservando o dist stub inicial se necessário)
frontend/dist
frontend/dist/*
!frontend/dist/frontend/
!frontend/dist/frontend/browser/
!frontend/dist/frontend/browser/index.html

# --- Tauri Desktop Shell ---
/src-tauri/target/
/src-tauri/WixTools/
/src-tauri/gen/

# --- Bancos de Dados Locais e Temporários ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Relatórios e Arquivos Exportados nos Testes ---
*.export.json
*.export.csv
*.export.html
schemalens_test.*

# --- IDEs e Editores ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
